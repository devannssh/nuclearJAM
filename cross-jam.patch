+          <h2 className="mr-2 text-2xl font-bold" data-testid="room-title">
+            {room.name}
+          </h2>
+          {room.genres.map((genre) => (
+            <Badge key={genre} variant="pill" color="secondary">
+              {genre}
+            </Badge>
+          ))}
