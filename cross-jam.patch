@@ -0,0 +1,76 @@
+import { ArrowBigUpIcon, XIcon } from 'lucide-react';
+import { FC } from 'react';
+
+import { useTranslation } from '@nuclearplayer/i18n';
+import type { JamRoomState } from '@nuclearplayer/model';
+import { Button, EmptyState } from '@nuclearplayer/ui';
+
+import { useCrossJamStore } from '../../../stores/crossJamStore';
+import { useJamMembership } from '../hooks/useJamMembership';
+
+export const QueueList: FC<{ room: JamRoomState }> = ({ room }) => {
+  const { t } = useTranslation('crossJam');
+  const { userId, member, isController } = useJamMembership();
+
+  return (
+    <div
+      data-testid="jam-queue"
+      className="flex flex-1 flex-col gap-2 overflow-y-auto"
+    >
+      <p className="text-foreground/70 text-sm">{t('room.addSongsHint')}</p>
+      {room.queue.length === 0 ? (
+        <EmptyState size="sm" title={t('room.queueEmpty')} />
+      ) : (
+        <ol className="flex flex-col gap-2">
+          {room.queue.map((item) => {
+            const hasVoted = !!userId && item.votes.includes(userId);
+            const canRemove = isController || item.addedBy === userId;
+            return (
+              <li
+                key={item.id}
+                data-testid="queue-row"
+                className="surface-background border-border flex items-center gap-3 rounded-md border-(length:--border-width) p-2"
+              >
+                <div className="flex min-w-0 flex-1 flex-col">
+                  <span className="truncate font-semibold">
+                    {item.track.title}
+                  </span>
+                  <span className="text-foreground/70 truncate text-sm">
+                    {item.track.artists.join(', ')} ·{' '}
+                    {t('room.addedBy', { name: item.addedByName })}
+                  </span>
+                </div>
+                <Button
+                  size="xs"
+                  variant={hasVoted ? 'default' : 'secondary'}
+                  disabled={member?.muted}
+                  aria-label={t('room.upvote')}
+                  onClick={() =>
+                    useCrossJamStore.getState().voteQueueItem(item.id)
+                  }
+                  data-testid="upvote-button"
+                >
+                  <ArrowBigUpIcon size={16} />
+                  <span data-testid="vote-count">{item.votes.length}</span>
+                </Button>
+                {canRemove && (
+                  <Button
+                    size="icon-sm"
+                    variant="ghost"
+                    aria-label={t('room.removeFromQueue')}
+                    onClick={() =>
+                      useCrossJamStore.getState().removeQueueItem(item.id)
+                    }
+                    data-testid="remove-queue-item"
+                  >
+                    <XIcon size={14} />
+                  </Button>
+                )}
+              </li>
+            );
+          })}
+        </ol>
+      )}
+    </div>
+  );
+};
diff --git a/packages/player/src/views/CrossJam/components/RecapDialog.tsx b/packages/player/src/views/CrossJam/components/RecapDialog.tsx
new file mode 100644
index 00000000..c4941d86
--- /dev/null
+++ b/packages/player/src/views/CrossJam/components/RecapDialog.tsx
@@ -0,0 +1,139 @@
+import { DateTime } from 'luxon';
+import { FC } from 'react';
+import { toast } from 'sonner';
+
+import { useTranslation } from '@nuclearplayer/i18n';
+import type { JamRecapTrackCount } from '@nuclearplayer/model';
+import { Button, Dialog } from '@nuclearplayer/ui';
+
+import { fromJamTrack } from '../../../services/crossJam/trackMapping';
+import { useCrossJamStore } from '../../../stores/crossJamStore';
+import { usePlaylistStore } from '../../../stores/playlistStore';
+
+const MS_PER_MINUTE = 60 * 1000;
+
+const CountList: FC<{
+  title: string;
+  entries: JamRecapTrackCount[];
+  testId: string;
+}> = ({ title, entries, testId }) => {
+  const { t } = useTranslation('crossJam');
+  return (
+    <section className="flex flex-col gap-1" data-testid={testId}>
+      <h4 className="font-bold">{title}</h4>
+      {entries.length === 0 ? (
+        <span className="text-foreground/70 text-sm">
+          {t('recapDialog.nothing')}
+        </span>
+      ) : (
+        <ol className="flex flex-col gap-1 text-sm">
+          {entries.map((entry) => (
+            <li key={`${entry.track.source.provider}:${entry.track.source.id}`}>
+              {entry.track.title} · {entry.track.artists.join(', ')}{' '}
+              <span className="opacity-70">
+                {t('recapDialog.times', { count: entry.count })}
+              </span>
+            </li>
+          ))}
+        </ol>
+      )}
+    </section>
+  );
+};
+
+export const RecapDialog: FC = () => {
+  const { t } = useTranslation('crossJam');
+  const recap = useCrossJamStore((state) => state.recap);
+  const dismiss = () => useCrossJamStore.getState().dismissRecap();
+
+  const playableTracks =
+    recap?.history
+      .filter((entry) => !entry.skipped)
+      .map((entry) => entry.track) ?? [];
+
+  const saveAsPlaylist = async () => {
+    if (!recap) {
+      return;
+    }
+    const name = `${recap.roomName} · ${DateTime.now().toLocaleString(DateTime.DATE_MED)}`;
+    const store = usePlaylistStore.getState();
+    const playlistId = await store.createPlaylist(name);
+    await store.addTracks(playlistId, playableTracks.map(fromJamTrack));
+    toast.success(t('room.playlistSaved', { name }));
+  };
+
+  return (
+    <Dialog
+      isOpen={recap !== null}
+      onClose={dismiss}
+      title={t('recapDialog.title')}
+      description={
+        recap
+          ? t('recapDialog.description', {
+              room: recap.roomName,
+              minutes: Math.max(
+                1,
+                Math.round(recap.durationMs / MS_PER_MINUTE),
+              ),
+            })
+          : undefined
+      }
+      actions={
+        <>
+          <Button
+            variant="secondary"
+            disabled={playableTracks.length === 0}
+            onClick={() => void saveAsPlaylist()}
+            data-testid="save-playlist-button"
+          >
+            {t('room.saveAsPlaylist')}
+          </Button>
+          <Button onClick={dismiss} data-testid="recap-close">
+            {t('recapDialog.close')}
+          </Button>
+        </>
+      }
+    >
+      {recap && (
+        <div data-testid="recap-content" className="flex flex-col gap-4">
+          <div className="flex gap-8">
+            <div className="flex flex-col">
+              <span className="text-sm opacity-70">
+                {t('recapDialog.tracksPlayed')}
+              </span>
+              <span
+                className="text-2xl font-bold"
+                data-testid="recap-tracks-played"
+              >
+                {recap.tracksPlayed}
+              </span>
+            </div>
+            <div className="flex flex-col">
+              <span className="text-sm opacity-70">
+                {t('recapDialog.topContributor')}
+              </span>
+              <span className="font-bold" data-testid="recap-top-contributor">
+                {recap.topContributor
+                  ? t('recapDialog.contributorValue', {
+                      name: recap.topContributor.displayName,
+                      count: recap.topContributor.added,
+                    })
+                  : t('recapDialog.nothing')}
+              </span>
+            </div>
+          </div>
+          <CountList
+            title={t('recapDialog.mostAdded')}
+            entries={recap.mostAdded}
+            testId="recap-most-added"
+          />
+          <CountList
+            title={t('recapDialog.mostSkipped')}
+            entries={recap.mostSkipped}
+            testId="recap-most-skipped"
+          />
+        </div>
+      )}
+    </Dialog>
+  );
+};
diff --git a/packages/player/src/views/CrossJam/components/RoomBrowser.tsx b/packages/player/src/views/CrossJam/components/RoomBrowser.tsx
new file mode 100644
index 00000000..c26f0ae1
--- /dev/null
+++ b/packages/player/src/views/CrossJam/components/RoomBrowser.tsx
@@ -0,0 +1,168 @@
+import { PlusIcon, RefreshCwIcon, UsersIcon } from 'lucide-react';
+import { FC, useEffect, useState } from 'react';
+
+import { useTranslation } from '@nuclearplayer/i18n';
+import type { JamRoomSummary } from '@nuclearplayer/model';
+import { Badge, Button, EmptyState, Input } from '@nuclearplayer/ui';
+
+import { useCrossJamStore } from '../../../stores/crossJamStore';
+import { CreateRoomDialog } from './CreateRoomDialog';
+
+const REFRESH_INTERVAL_MS = 10000;
+
+const RoomCard: FC<{ room: JamRoomSummary }> = ({ room }) => {
+  const { t } = useTranslation('crossJam');
+
+  return (
+    <li
+      data-testid="room-card"
+      className="surface-background border-border shadow-shadow flex flex-col gap-3 rounded-md border-(length:--border-width) p-4"
+    >
+      <div className="flex items-start justify-between gap-3">
+        <div className="flex min-w-0 flex-col">
+          <h3 className="truncate text-lg font-bold">{room.name}</h3>
+          <span className="text-foreground/70 text-sm">
+            {room.hostName
+              ? t('rooms.hostedBy', { name: room.hostName })
+              : null}
+          </span>
+        </div>
+        <Badge
+          variant="pill"
+          color={
+            room.match >= 60 ? 'green' : room.match > 0 ? 'yellow' : 'secondary'
+          }
+          data-testid="room-match"
+        >
+          {t('rooms.match', { percent: room.match })}
+        </Badge>
+      </div>
+      <div className="flex flex-wrap gap-1">
+        {room.genres.map((genre) => (
+          <Badge key={genre} variant="pill" color="secondary">
+            {genre}
+          </Badge>
+        ))}
+      </div>
+      <div className="text-foreground/70 text-sm">
+        {room.nowPlaying
+          ? `${room.nowPlaying.title} · ${room.nowPlaying.artists.join(', ')}`
+          : t('rooms.nothingPlaying')}
+      </div>
+      <div className="flex items-center justify-between">
+        <span className="flex items-center gap-1 text-sm">
+          <UsersIcon size={16} />
+          {t('rooms.listeners', { count: room.memberCount })}
+        </span>
+        <Button
+          size="sm"
+          disabled={room.full}
+          onClick={() =>
+            useCrossJamStore.getState().joinRoom({ roomId: room.id })
+          }
+          data-testid="join-room-button"
+        >
+          {room.full ? t('rooms.full') : t('rooms.join')}
+        </Button>
+      </div>
+    </li>
+  );
+};
+
+export const RoomBrowser: FC = () => {
+  const { t } = useTranslation('crossJam');
+  const rooms = useCrossJamStore((state) => state.rooms);
+  const [isCreateOpen, setIsCreateOpen] = useState(false);
+  const [inviteCode, setInviteCode] = useState('');
+
+  useEffect(() => {
+    const interval = setInterval(
+      () => useCrossJamStore.getState().refreshRooms(),
+      REFRESH_INTERVAL_MS,
+    );
+    return () => clearInterval(interval);
+  }, []);
+
+  const joinWithCode = () => {
+    const code = inviteCode.trim();
+    if (code) {
+      useCrossJamStore.getState().joinRoom({ inviteCode: code });
+      setInviteCode('');
+    }
+  };
+
+  return (
+    <div
+      data-testid="room-browser"
+      className="flex flex-1 flex-col gap-4 overflow-y-auto p-4"
+    >
+      <div className="flex flex-wrap items-end gap-3">
+        <Button
+          onClick={() => setIsCreateOpen(true)}
+          data-testid="create-room-button"
+        >
+          <PlusIcon size={16} />
+          {t('rooms.create')}
+        </Button>
+        <Button
+          variant="secondary"
+          onClick={() => useCrossJamStore.getState().refreshRooms()}
+          data-testid="refresh-rooms-button"
+        >
+          <RefreshCwIcon size={16} />
+          {t('rooms.refresh')}
+        </Button>
+        <div className="ml-auto flex items-end gap-2">
+          <Input
+            label={t('rooms.joinWithCode')}
+            placeholder={t('rooms.codePlaceholder')}
+            value={inviteCode}
+            onChange={(event) => setInviteCode(event.target.value)}
+            onKeyDown={(event) => {
+              if (event.key === 'Enter') {
+                joinWithCode();
+              }
+            }}
+            data-testid="invite-code-input"
+          />
+          <Button
+            variant="secondary"
+            disabled={!inviteCode.trim()}
+            onClick={joinWithCode}
+            data-testid="join-with-code-button"
+          >
+            {t('rooms.join')}
+          </Button>
+        </div>
+      </div>
+
+      {rooms.length === 0 ? (
+        <EmptyState
+          data-testid="rooms-empty"
+          title={t('rooms.empty')}
+          action={
+            <Button onClick={() => setIsCreateOpen(true)}>
+              {t('rooms.create')}
+            </Button>
+          }
+        />
+      ) : (
+        <>
+          <p className="text-foreground/70 text-sm">
+            {t('rooms.sortedByMatch')}
+          </p>
+          <ul className="grid grid-cols-1 gap-4 lg:grid-cols-2">
+            {rooms.map((room) => (
+              <RoomCard key={room.id} room={room} />
+            ))}
+          </ul>
+        </>
+      )}
+
+      <CreateRoomDialog
+        isOpen={isCreateOpen}
+        onClose={() => setIsCreateOpen(false)}
+      />
+    </div>
+  );
+};
