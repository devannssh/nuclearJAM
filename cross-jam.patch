+        <RoomSettingsDialog
+          key={isSettingsOpen ? 'open' : 'closed'}
+          room={room}
+          isOpen={isSettingsOpen}
+          onClose={() => setIsSettingsOpen(false)}
+        />
+      )}
+    </div>
+  );
+};
